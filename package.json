{
  "name": "acaweb",
  "version": "1.0.0",
  "description": "API Express para exponer un servicio básico de prueba",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --check src/server.js",
    "check:root": "curl -s http://localhost:3000/",
    "check:health": "curl -s http://localhost:3000/api/health",
    "check:info": "curl -s http://localhost:3000/api/info",
    "check:frutas": "curl -s http://localhost:3000/api/frutas",
    "check:fruta": "curl -s http://localhost:3000/api/frutas/3",
    "check:analisis": "curl -s \"http://localhost:3000/api/frutas/analisis?id=3\"",
    "check:all": "npm run check:root && npm run check:health && npm run check:info && npm run check:frutas && npm run check:fruta && npm run check:analisis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeygok/acaweb.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/yeygok/acaweb/issues"
  },
  "homepage": "https://github.com/yeygok/acaweb#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.12.1"
  }
}
